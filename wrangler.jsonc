{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-impact-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ImpactTracker",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "IMPACT_TRACKER", "class_name": "ImpactTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImpactTracker"] }]
}
